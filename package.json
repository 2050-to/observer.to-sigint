{
  "name": "wifi-mapping",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "server": "npm run dev --prefix server",
    "test": "npm test --prefix server",
    "setup": "bash scripts/dev-certs.sh",
    "cap:sync": "npm run build && npx cap sync android",
    "mac:dmg": "npm run build && node scripts/build-mac.mjs"
  },
  "build": {
    "appId": "com.wifimapping.app",
    "productName": "Wi-Fi Mapping",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "macos/addon/build/Release/scanner.node",
      "package.json"
    ],
    "asarUnpack": [
      "**/scanner.node"
    ],
    "extraResources": [
      {
        "from": "build-resources/ca.crt",
        "to": "ca.crt"
      }
    ],
    "mac": {
      "identity": "-",
      "hardenedRuntime": true,
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSLocationUsageDescription": "Wi-Fi Mapping records where this Mac heard each network and advertisement.",
        "NSLocationWhenInUseUsageDescription": "Wi-Fi Mapping records where this Mac heard each network and advertisement.",
        "NSBluetoothAlwaysUsageDescription": "Wi-Fi Mapping reads public Bluetooth advertisements. It does not connect to devices.",
        "NSBluetoothPeripheralUsageDescription": "Wi-Fi Mapping reads public Bluetooth advertisements. It does not connect to devices."
      }
    }
  },
  "main": "electron/dist/main.cjs",
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "cytoscape": "^3.32.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@electron/rebuild": "^4.2.1",
    "@types/cytoscape": "^3.21.9",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
